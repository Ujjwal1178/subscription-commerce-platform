# =============================================================================
# SUBSCRIPTION COMMERCE PLATFORM - ENVIRONMENT VARIABLES
# Test comment for git contribution check - can be removed later
# =============================================================================
# Copy this file to .env and update values for your environment
# NEVER commit .env to git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# APP MODE
# -----------------------------------------------------------------------------
IS_DEV_MODE=True
# True = Development (shows OTP in logs, detailed errors)
# False = Production (OTP via email only, minimal logs)

DEBUG=True
LOG_LEVEL=DEBUG
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Service-specific DB URLs
AUTH_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/auth_db
SUBSCRIPTION_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/user_subs_db
PAYMENT_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/payment_db
NOTIFICATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/notification_db

# -----------------------------------------------------------------------------
# REDIS (for rate limiting, caching)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# KAFKA (for events)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# -----------------------------------------------------------------------------
# SECURITY - CHANGE THESE IN PRODUCTION!
# -----------------------------------------------------------------------------
# 32 bytes key for AES-256 encryption
ENCRYPTION_KEY=dev-key-32-bytes-long-exactly!!

# JWT Secret - use strong random string in production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-use-strong-random
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# TOKEN SETTINGS
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=7
REFRESH_TOKEN_EXPIRE_MINUTES=120

# -----------------------------------------------------------------------------
# OTP SETTINGS
# -----------------------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_BLOCK_MINUTES=20
OTP_LENGTH=6

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
OTP_RESEND_RATE_LIMIT_PER_10MIN=3

# -----------------------------------------------------------------------------
# SERVICE PORTS
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=8001
SUBSCRIPTION_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004

# -----------------------------------------------------------------------------
# EMAIL (Notification Service - for production)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# -----------------------------------------------------------------------------
# STRIPE (Payment Gateway - for production)
# -----------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
